# =====================================================================
# Omnichannel Branch Assistant - Production Environment Variables
# Copy to .env on the server: cp .env.production.example .env
# =====================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
SECRET_KEY=change_this_to_a_super_random_64_character_hex_secret_in_prod

# Agent & Branch Configuration
AGENT_NAME="Navitas AI Asistanı"
DEFAULT_BRANCH=istanbul-airport

# AI Provider Settings (openai / gemini / anthropic)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
TEMPERATURE=0.3
MAX_TOKENS=600

# WhatsApp Puppeteer Bridge
BRIDGE_API_URL=http://bridge:3001
AUTO_START_BRIDGE=false

# Redis & Cache (Required for message debounce buffer & rate limiting)
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# Database Settings (Defaults to SQLite; for Postgres set connection URL)
DATABASE_PATH=/app/backend/omnichannel_data.db
# POSTGRES_URL=postgresql://omni_user:omni_pass_secure_2026@postgres:5432/omnichannel_db

# Meta Cloud Webhook (Instagram DM & WhatsApp Cloud API)
META_WEBHOOK_VERIFY_TOKEN=omni_meta_secure_verify_token_2026
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# Telegram Bot Adapter
TELEGRAM_BOT_TOKEN=

# Notifications (Push notifications via ntfy.sh)
NTFY_SERVER_URL=https://ntfy.sh
NTFY_GLOBAL_TOPIC=omni-navitas-alerts-prod

# Security / Safety Controls
SAFE_BLOCK_LIST=
SAFE_ALLOW_LIST=
TEST_MODE_ENABLED=false
TEST_PREFIX=-test
HALLUCINATION_GUARD_ENABLED=true
LANG_DETECT_ENABLED=true
