# =====================================================================
# Enterprise Omnichannel AI Assistant & Unified Control Center
# Multi-Tenant Environment Configuration (17 Centers / 4 Channels — Navitas Spa & Wellness)
# =====================================================================

# ---------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production # development | production
DEBUG=false

# ---------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# Dual engine: Leave DATABASE_URL empty for zero-setup SQLite,
# or provide a PostgreSQL connection URI for enterprise deployment.
# ---------------------------------------------------------------------
DATABASE_PATH=backend/omnichannel_data.db
# DATABASE_URL=postgresql://omni_user:omni_pass_secure@localhost:5432/omnichannel_db

# ---------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Debounce buffer, session cache, rate limiter)
# Falls back gracefully to memory buffer if Redis is not running.
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
DEBOUNCE_SECONDS=15

# ---------------------------------------------------------------------
# 4. JWT & RBAC AUTHENTICATION
# ---------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-super-secret-random-hex-key-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Initial Super Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@navitasspa.com
INITIAL_ADMIN_PASSWORD=AdminSecure2026!
INITIAL_ADMIN_NAME="Navitas Spa Genel Direktörü"

# ---------------------------------------------------------------------
# 5. LLM PROVIDER CONFIGURATION
# Provider: openai | groq | openrouter | gemini | ollama
# ---------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=sk-proj-YOUR_OPENAI_OR_GROQ_API_KEY_HERE
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=45.0
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9

# Groq Alternative (Lightning fast & cost-effective):
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_YOUR_GROQ_KEY_HERE
# LLM_MODEL=llama-3.3-70b-versatile

# Local Ollama Alternative:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ---------------------------------------------------------------------
# 6. OMNICHANNEL CREDENTIALS & WEBHOOK VERIFICATION TOKENS
# ---------------------------------------------------------------------
# Meta Shared Webhook Verify Token (used across WhatsApp Cloud, Instagram, Messenger)
META_WEBHOOK_VERIFY_TOKEN=omni_meta_secure_verify_token_2026

# WhatsApp Cloud API (Graph API)
WHATSAPP_API_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Instagram Direct Messages (Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Facebook Messenger (Page Messaging)
MESSENGER_ACCESS_TOKEN=
MESSENGER_PAGE_ID=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Local WhatsApp Web Bridge (Node.js session adapter)
BRIDGE_API_URL=http://127.0.0.1:3001
TRIGGER_PREFIX=

# ---------------------------------------------------------------------
# 7. SECURITY & RATE LIMITING
# ---------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_DAILY=40
ENABLE_JAILBREAK_FILTER=true
ENABLE_OFFTOPIC_FILTER=true

# ---------------------------------------------------------------------
# 8. MOBILE NOTIFICATIONS & INSTANT ALERTING (ntfy.sh)
# ---------------------------------------------------------------------
NTFY_SERVER_URL=https://ntfy.sh
NTFY_GLOBAL_TOPIC=navitas-spa-global-alerts
# Branch specific alerts will automatically dispatch to: {NTFY_GLOBAL_TOPIC}-{branch_id}
